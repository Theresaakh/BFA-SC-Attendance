# =============================================================================
# BFA Admin dashboard — server configuration
# Copy to `.env` (never commit it) and fill in the values. Every variable here is
# read on the server only; nothing is ever sent to the browser.
# =============================================================================

# --- Database (required) ------------------------------------------------------
# PostgreSQL 14+ connection string.
DATABASE_URL=postgres://bfa:CHANGE_ME@localhost:5432/bfa_dashboard
# disable | require (verify certificate) | no-verify (managed DBs with self-signed certs)
DATABASE_SSL=disable

# --- Sign-in ------------------------------------------------------------------
# Session lifetime in hours.
SESSION_TTL_HOURS=12
# auto = secure cookies in production. Set to "true" behind HTTPS, "false" only for local HTTP.
COOKIE_SECURE=auto
# Optional: creates the first administrator on start-up when there are no users yet.
# Remove these after the first start (or use `npm run user:create` instead).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=BFA Administrator

# --- Odoo (customer invoices) -------------------------------------------------
# Odoo Online URL, e.g. https://beirut-football-academy.odoo.com
ODOO_URL=
# Database name — on Odoo Online this is normally the sub-domain (beirut-football-academy).
ODOO_DB=
# Login e-mail of the Odoo user the dashboard reads as (read access to Accounting is enough).
ODOO_LOGIN=
# API key of that user: Odoo → Settings → Users → <user> → Account Security → New API Key.
ODOO_API_KEY=
# auto (recommended) | jsonrpc | json2 (Odoo 19+ JSON-2 API)
ODOO_API_PROTOCOL=auto
ODOO_TIMEOUT_MS=30000
# Optional: only read invoices of this company id (multi-company databases).
ODOO_COMPANY_ID=
# Contact field that holds the BFA player ID, used as the strongest matching signal.
# Default "ref" = the contact's "Reference" field in Odoo.
ODOO_PLAYER_ID_FIELD=ref
# Optional: ignore invoices dated before this day (YYYY-MM-DD).
ODOO_INVOICE_START_DATE=

# --- BFA attendance app (app.bfa-lebanon.com) --------------------------------
# The attendance app stores its data in Firebase Realtime Database; the dashboard
# reads it (read-only) through Firebase's REST API.
BFA_FIREBASE_DATABASE_URL=https://bfa-sc-tracker-default-rtdb.europe-west1.firebasedatabase.app
# Data root used by teams.html. (The older index.html tracker uses "bfaState".)
BFA_FIREBASE_ROOT_PATH=bfaTeamsState
# service_account (recommended) | database_secret (legacy) | none (only if the rules allow public reads)
BFA_FIREBASE_AUTH_MODE=service_account
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON on one line, or its base64 encoding.
BFA_FIREBASE_SERVICE_ACCOUNT_JSON=
# Only for BFA_FIREBASE_AUTH_MODE=database_secret
BFA_FIREBASE_DATABASE_SECRET=
BFA_TIMEOUT_MS=30000

# --- Synchronisation ----------------------------------------------------------
# Default automatic sync interval in minutes (0 = off). Can be changed later in Settings.
SYNC_INTERVAL_MINUTES=60
# Built-in scheduler. Set to false on serverless hosting and call /api/cron/sync instead.
SYNC_SCHEDULER_ENABLED=true
# Enables POST /api/cron/sync with "Authorization: Bearer <CRON_SECRET>". Use a long random value.
CRON_SECRET=
# Timezone used for "today" (overdue invoices, date presets).
APP_TIMEZONE=Asia/Beirut
